{
  "name": "adhd-world-championship",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "granite dev",
    "dev:web": "vite --host 0.0.0.0",
    "build": "ait build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "deploy": "ait deploy",
    "qa": "node scripts/run_qa.mjs",
    "qa:headed": "node scripts/run_qa.mjs --headed",
    "qa:install": "playwright install chromium",
    "verify:release": "node scripts/verify_release_bundle.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "2.10.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.0.15",
    "@playwright/test": "1.61.1"
  },
  "engines": {
    "node": ">=24"
  }
}
